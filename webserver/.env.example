# Riot Games API Configuration
# ============================

# Tu API Key de Riot Games (Development Key: dura 24hs, hay que renovarla seguido)
# Obtené la tuya en: https://developer.riotgames.com/
# NO COMPARTAS ESTA KEY NI LA SUBAS A GIT
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Región de la plataforma de Riot (la2, na1, euw1, kr, etc.)
RIOT_PLATFORM=la2

# Base de datos local (cache de partidas) - no requiere instalar nada, es un archivo
DATABASE_URL="file:./dev.db"

# Puerto del servidor Next.js (opcional)
PORT=3000
